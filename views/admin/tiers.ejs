<%- include('../partials/head') %>
<main class="page">
  <%- include('../partials/flash') %>
  <div class="page-head"><div><h1>Account tiers</h1><p>Set the upgrade amount and benefits for each tier. Clients choose an upgrade, deposit the amount into their own balance, and move up automatically when you approve that deposit.</p></div></div>

  <div class="alert alert-info" role="note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg>
    <span><strong>Keep the benefits real</strong>List only services AlsetMarkets actually provides at each tier. The upgrade page tells clients the deposit stays theirs and that their current account keeps working the same. Don't say or imply that lower tiers lose or can't hold profits.</span>
  </div>

  <section class="tier-grid" aria-label="Tiers">
    <% tiers.forEach(function (t) { %>
    <form method="post" action="/admin/tiers/<%= t.id %>" class="card stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="plan-head"><h2 style="font-size: 20px"><%= t.name %></h2><span class="pill pill-info"><%= counts[t.name] || 0 %> client<%= (counts[t.name] || 0) === 1 ? '' : 's' %></span></div>
      <div class="field"><label for="ua-<%= t.id %>">Upgrade amount (USD)</label><input id="ua-<%= t.id %>" name="upgrade_amount" type="text" inputmode="decimal" value="<%= t.upgrade_amount ? Number(t.upgrade_amount).toFixed(2) : '' %>" placeholder="Leave empty for an entry tier"><span class="hint">The deposit a client makes to move up to this tier.</span></div>
      <div class="field"><label for="ub-<%= t.id %>">Benefits (one per line)</label><textarea id="ub-<%= t.id %>" name="benefits" rows="4"><%= t.benefits || '' %></textarea></div>
      <label class="check"><input type="checkbox" name="offered" <%= t.offered ? 'checked' : '' %>> Offer as an upgrade</label>
      <div><button class="btn btn-primary" type="submit">Save <%= t.name %></button></div>
    </form>
    <% }) %>
  </section>

  <section class="card">
    <div class="card-head"><h2>Upgrade requests</h2><span class="muted" style="font-size: 13px">A request completes automatically when its deposit is approved for at least the upgrade amount.</span></div>
    <% if (requests.length) { %>
    <div class="table-wrap">
      <table class="data" style="min-width: 760px">
        <thead><tr><th>Client</th><th>Upgrade</th><th class="r">Amount</th><th>Status</th><th>Requested</th><th class="r">Actions</th></tr></thead>
        <tbody>
        <% requests.forEach(function (r) { %>
          <tr>
            <td><a href="/admin/clients/<%= r.user_id %>#profile"><%= r.full_name %></a> <span class="num muted"><%= r.account_no %></span></td>
            <td><%= r.from_tier || '—' %> → <strong><%= r.target_tier %></strong></td>
            <td class="r num"><%= money(r.amount) %></td>
            <td><span class="pill pill-<%= r.status === 'completed' ? 'completed' : r.status === 'cancelled' ? 'neutral' : 'pending' %>"><%= titleCase(r.status) %></span></td>
            <td class="muted"><%= fmtDateTime(r.created_at) %></td>
            <td class="r" style="white-space: nowrap">
              <% if (r.status === 'awaiting_deposit' || r.status === 'deposit_submitted') { %>
                <form method="post" action="/admin/upgrade-requests/<%= r.id %>/complete" class="inline" data-confirm="Upgrade this client to <%= r.target_tier %> now, without waiting for the deposit?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm" type="submit">Upgrade now</button></form>
                <form method="post" action="/admin/upgrade-requests/<%= r.id %>/cancel" class="inline" data-confirm="Cancel this upgrade request?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm" type="submit">Cancel</button></form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %><div class="empty">No upgrade requests yet.</div><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
