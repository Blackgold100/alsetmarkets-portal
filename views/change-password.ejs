<%- include('partials/head', { title: 'Change password' }) %>
<main class="page" style="max-width: 560px">
  <div class="card stack">
    <div>
      <h1 style="font-size: 22px"><%= forced ? 'Set a new password' : 'Change password' %></h1>
      <p class="muted" style="margin: 6px 0 0"><%= forced ? 'For your security, replace the temporary password you were given before continuing.' : 'Use at least 10 characters with letters and numbers.' %></p>
    </div>
    <% if (error) { %><div class="alert alert-error" role="alert"><span><%= error %></span></div><% } %>
    <form method="post" action="/account/password" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="current"><%= forced ? 'Temporary password' : 'Current password' %></label>
        <input id="current" name="current" type="password" required autocomplete="current-password">
      </div>
      <div class="field">
        <label for="next">New password</label>
        <input id="next" name="next" type="password" required minlength="10" autocomplete="new-password">
        <span class="hint">At least 10 characters, including letters and numbers.</span>
      </div>
      <div class="field">
        <label for="confirm">Confirm new password</label>
        <input id="confirm" name="confirm" type="password" required minlength="10" autocomplete="new-password">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save password</button>
        <% if (!forced) { %><a class="btn btn-outline" href="<%= user.role === 'admin' ? '/admin' : '/account' %>">Cancel</a><% } %>
      </div>
    </form>
  </div>
</main>
<%- include('partials/foot') %>
