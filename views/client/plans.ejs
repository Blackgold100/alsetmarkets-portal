<%- include('../partials/head') %>
<% const cur = user.base_currency; const s = summary;
   const active = positions.filter(function (p) { return p.status === 'active'; });
   const planPl = active.reduce(function (a, p) { return a + (p.value - p.principal); }, 0); %>
<main class="page">
  <%- include('../partials/flash') %>
  <div class="page-head">
    <div><h1>Investment plans</h1><p>Put part of your balance to work in a managed plan. Results are posted weekly from each plan's actual performance.</p></div>
    <a class="btn btn-outline" href="/funds/deposit">Add funds</a>
  </div>

  <section class="kpis" aria-label="Plan balances">
    <div class="card kpi accent"><div class="label">Available to invest</div><div class="value num"><%= money(s.available, cur) %></div><div class="sub">From your account balance of <span class="num"><%= money(s.balance, cur) %></span></div></div>
    <div class="card kpi"><div class="label">Invested in plans</div><div class="value num"><%= money(s.inPlans, cur) %></div><div class="sub"><%= active.length %> open investment<%= active.length === 1 ? '' : 's' %></div></div>
    <div class="card kpi"><div class="label">Plan profit / loss</div><div class="value num <%= planPl < 0 ? 'down' : planPl > 0 ? 'up' : '' %>"><%= signedMoney(planPl, cur) %></div><div class="sub">On open investments, after posted results</div></div>
  </section>

  <% if (limit.limit !== null) { const usedPct = Math.min(100, limit.used / limit.limit * 100); %>
  <section class="card threshold" aria-label="Tier threshold">
    <div class="card-head" style="margin-bottom: 8px">
      <h2><%= limit.tier %> tier · plan investment limit</h2>
      <span class="num" style="font-weight: 600"><%= money(limit.used, cur, 0) %> of <%= money(limit.limit, cur, 0) %> used</span>
    </div>
    <div class="meter" role="meter" aria-valuemin="0" aria-valuemax="<%= limit.limit %>" aria-valuenow="<%= limit.used %>" aria-label="Plan investment limit used"><span style="width: <%= usedPct.toFixed(1) %>%"></span></div>
    <div style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 10px; font-size: 13px">
      <span class="muted"><%= limit.remaining > 0 ? 'You can add up to ' + money(limit.remaining, cur, 0) + ' more to plans on your current tier.' : 'You have reached your current tier\'s limit for new plan investments.' %> Profits earned inside plans don't count toward it.</span>
      <% if (nextTier) { %><a href="/upgrade" style="font-weight: 600">Upgrade to <%= nextTier.name %><%= nextTier.plan_limit !== null ? ' for up to ' + money(nextTier.plan_limit, cur, 0) : ' for no limit' %> →</a><% } %>
    </div>
  </section>
  <% } %>

  <div class="alert alert-info" role="note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg>
    <span><strong>How returns work</strong>Returns are not fixed or guaranteed. Each week <%= brand.name %> posts every plan's actual result, which can be a gain or a loss, and your share is credited to or deducted from your balance automatically. Money in a plan can be moved back to your available balance once its lock-in period ends.</span>
  </div>

  <section class="plan-grid" aria-label="Plans">
    <% plans.forEach(function (p) { %>
    <article class="card plan-card" id="plan-<%= p.slug %>">
      <div class="plan-head">
        <div><h2 style="font-size: 20px"><%= p.name %></h2><p class="muted" style="margin: 4px 0 0"><%= p.summary %></p></div>
        <span style="display: flex; flex-direction: column; align-items: flex-end; gap: 6px">
          <span class="pill <%= /high/i.test(p.risk_level) ? 'pill-pending' : 'pill-info' %>"><%= p.risk_level %> risk</span>
          <% if (p.min_tier) { %><span class="pill pill-gold"><%= p.min_tier %> tier</span><% } %>
        </span>
      </div>
      <dl class="plan-facts">
        <div><dt>Minimum</dt><dd class="num"><%= money(p.min_amount, cur, 0) %></dd></div>
        <div><dt>Lock-in</dt><dd><%= p.lock_days ? p.lock_days + ' days' : 'None' %></dd></div>
        <div><dt>Results</dt><dd>Weekly</dd></div>
      </dl>
      <div>
        <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 6px">
          <span class="label-txt">Past results<%= p.recent.length ? ' · last ' + p.recent.length + ' week' + (p.recent.length === 1 ? '' : 's') : '' %></span>
          <% if (p.recentCompound !== null) { %><span class="num <%= p.recentCompound < 0 ? 'down' : 'up' %>" style="font-weight: 600; font-size: 13px"><%= pct(p.recentCompound) %> total</span><% } %>
        </div>
        <%- include('../partials/plan-bars', { results: p.recent }) %>
        <% if (p.recent.length) { const last = p.recent[p.recent.length - 1]; %>
          <div class="muted" style="font-size: 12px; margin-top: 4px">Latest: <%= fmtDate(last.period_start) %> to <%= fmtDate(last.period_end) %>, <span class="num <%= last.return_pct < 0 ? 'down' : 'up' %>"><%= (last.return_pct >= 0 ? '+' : '') + Number(last.return_pct).toFixed(2) %>%</span>. Past results do not predict future returns.</div>
        <% } %>
      </div>
      <% if (p.description) { %><details class="box"><summary>About this plan</summary><p style="margin: 0; color: var(--ink-2)"><%= p.description %></p></details><% } %>
      <% if (!p.eligible) { %>
      <div class="plan-form plan-locked">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <div><strong>Available from the <%= p.min_tier %> tier</strong><div class="muted" style="font-size: 13px">You're on <%= user.tier %>. Upgrade to invest in this plan.</div></div>
        <a class="btn btn-gold" href="/upgrade">Upgrade to <%= p.min_tier %></a>
      </div>
      <% } else { %>
      <form method="post" action="/plans/<%= p.id %>/invest" class="stack plan-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="amt-<%= p.id %>">Amount to invest (<%= cur %>)</label><input id="amt-<%= p.id %>" name="amount" type="text" inputmode="decimal" required placeholder="Min <%= money(p.min_amount, cur, 0) %>"></div>
        <div class="field"><label for="pw-<%= p.id %>">Confirm with your password</label><input id="pw-<%= p.id %>" name="password" type="password" required autocomplete="current-password"></div>
        <label class="check" style="align-items: flex-start; font-weight: 400; font-size: 13px; min-height: 0"><input type="checkbox" name="accept" required style="margin-top: 2px"> <span>I understand returns can be negative, and this money is locked for <%= p.lock_days %> days.</span></label>
        <button class="btn btn-primary" type="submit" <%= s.available < p.min_amount || user.status !== 'active' || (limit.limit !== null && limit.remaining < p.min_amount) ? 'disabled' : '' %>>Invest in <%= p.name %></button>
        <% if (user.status !== 'active') { %><span class="hint">Available once your account is active.</span><% } else if (limit.limit !== null && limit.remaining < p.min_amount) { %><span class="hint">You've reached your <%= limit.tier %> tier's plan limit. <a href="/upgrade">Upgrade to invest more</a></span><% } else if (s.available < p.min_amount) { %><span class="hint">You need at least <%= money(p.min_amount, cur, 0) %> available. <a href="/funds/deposit">Add funds</a></span><% } %>
      </form>
      <% } %>
    </article>
    <% }) %>
  </section>

  <section class="card" id="my-investments" aria-label="My investments">
    <div class="card-head"><h2>My investments</h2><span class="muted" style="font-size: 13px">Values update each time a weekly result is posted.</span></div>
    <% if (positions.length) { %>
    <div class="table-wrap">
      <table class="data" style="min-width: 860px">
        <thead><tr><th>Plan</th><th class="r">Invested</th><th class="r">Current value</th><th class="r">Profit / loss</th><th>Started</th><th>Unlocks</th><th>Status</th><th></th></tr></thead>
        <tbody>
        <% positions.forEach(function (x) { const pl = x.value - x.principal; %>
          <tr>
            <td style="font-weight: 600"><%= x.plan_name %></td>
            <td class="r num"><%= money(x.principal, cur) %></td>
            <td class="r num" style="font-weight: 600"><%= money(x.value, cur) %></td>
            <td class="r num <%= pl < 0 ? 'down' : pl > 0 ? 'up' : '' %>"><%= signedMoney(pl, cur) %><div style="font-size: 12px"><%= pct(x.pnlPct) %></div></td>
            <td class="muted"><%= fmtDate(x.started_on) %></td>
            <td><%= fmtDate(x.unlocks_on) %></td>
            <td><% if (x.status === 'closed') { %><span class="pill pill-neutral">Withdrawn</span><% } else if (x.unlocked) { %><span class="pill pill-active">Unlocked</span><% } else { %><span class="pill pill-info">Locked · <%= x.daysLeft %> day<%= x.daysLeft === 1 ? '' : 's' %></span><% } %></td>
            <td class="r">
              <% if (x.status === 'active' && x.unlocked) { %>
              <form method="post" action="/plans/positions/<%= x.id %>/redeem" class="inline" data-confirm="Move <%= money(x.value, cur) %> from the <%= x.plan_name %> plan back to your available balance?">
                <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm" type="submit">Withdraw from plan</button>
              </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %><div class="empty">You haven't invested in a plan yet.</div><% } %>
  </section>
  <%- include('../partials/legal') %>
</main>
<%- include('../partials/foot') %>
