<%- include('../partials/head') %>
<% const cur = user.base_currency; %>
<main class="page" style="max-width: 1080px">
  <%- include('../partials/flash') %>
  <div class="page-head">
    <div><h1>Upgrade your account</h1><p>You're on the <strong><%= user.tier %></strong> tier. Higher tiers add more personal service. Upgrading is optional.</p></div>
    <a class="btn btn-outline" href="/">Back to overview</a>
  </div>

  <% if (open) { %>
  <div class="alert alert-<%= open.status === 'deposit_submitted' ? 'info' : 'warning' %>" role="status">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
    <span>
      <strong>Upgrade to <%= open.target_tier %> in progress</strong>
      <% if (open.status === 'deposit_submitted') { %>
        Your deposit is being confirmed. Your account moves to <%= open.target_tier %> as soon as our team approves it.
      <% } else { %>
        To finish, deposit <span class="num"><%= money(open.amount, cur) %></span> into your account.
        <span style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px">
          <a class="btn btn-primary btn-sm" href="/funds/deposit?upgrade=<%= open.id %>">Continue to deposit</a>
          <form method="post" action="/upgrade/cancel" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm" type="submit">Cancel upgrade</button></form>
        </span>
      <% } %>
    </span>
  </div>
  <% } %>

  <section class="card" aria-label="How upgrading works" style="background: #F8F9FB">
    <h2 style="margin-bottom: 10px">How upgrading works</h2>
    <ol class="how-list">
      <li><strong>Choose a tier below.</strong> Each tier has an upgrade amount.</li>
      <li><strong>Deposit that amount into your own account.</strong> It's added to your balance and <strong>stays your money</strong>: you can invest it in a plan or withdraw it under the normal rules.</li>
      <li><strong>Your tier changes once the deposit is confirmed.</strong> This usually takes less than one business day.</li>
    </ol>
    <p class="muted" style="margin: 10px 0 0; font-size: 13px">Your current account, balance, profits and plan investments keep working the same way whether or not you upgrade. Nothing is charged for upgrading.</p>
  </section>

  <% if (offers.length) { %>
  <section class="tier-grid" aria-label="Upgrade options">
    <% offers.forEach(function (t, i) { %>
    <article class="card tier-card<%= i === offers.length - 1 ? ' tier-top' : '' %>">
      <div>
        <div class="eyebrow"><%= i === offers.length - 1 ? 'Highest tier' : 'Upgrade' %></div>
        <h2 style="font-size: 24px; margin-top: 4px"><%= t.name %></h2>
      </div>
      <div>
        <div class="muted" style="font-size: 13px">Upgrade amount</div>
        <div class="num" style="font-size: 30px; font-weight: 600"><%= money(t.upgrade_amount, cur, 0) %></div>
        <div class="muted" style="font-size: 13px">Deposited to your own balance</div>
      </div>
      <% if (t.benefitList.length) { %>
      <ul class="benefits">
        <% t.benefitList.forEach(function (b) { %><li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><%= b %></span></li><% }) %>
      </ul>
      <% } %>
      <form method="post" action="/upgrade/<%= t.id %>/choose" style="margin-top: auto">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn <%= i === offers.length - 1 ? 'btn-gold' : 'btn-primary' %>" type="submit" style="width: 100%" <%= open && open.status === 'deposit_submitted' ? 'disabled' : '' %>>Choose <%= t.name %></button>
      </form>
    </article>
    <% }) %>
  </section>
  <% } else { %>
  <div class="card"><div class="empty">There are no higher tiers to upgrade to right now. You're on our top available tier, or upgrades aren't open yet.</div></div>
  <% } %>

  <p class="muted" style="font-size: 13px">Questions about tiers? Use the chat button or email <a href="mailto:<%= brand.supportEmail %>"><%= brand.supportEmail %></a>.</p>
  <%- include('../partials/legal') %>
</main>
<%- include('../partials/foot') %>
